local.file_match "ir_logs" {
  path_targets = [
    {
      __path__ = "../../logs/*.log",
      job = "ir-assist",
      host = "windows",
    },
  ]
}

loki.source.file "logs" {
  targets    = local.file_match.ir_logs.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
  }
}
local.file_match "logs" {
  path_targets = [{
    __path__ = "C:/Users/Mridul/Desktop/mission_project/logs/*.log",
    job = "ir-assist"
  }]
}

prometheus.exporter.windows "windows" {}

prometheus.scrape "windows" {
  targets    = prometheus.exporter.windows.windows.targets
  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  endpoint {
    url = "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push"

    basic_auth {
      username = "3348842"
      password = env("GRAFANA_PROMETHEUS_TOKEN")
    }
  }
}

local.file_match "ir_logs" {
  path_targets = [{
    __path__ = "/logs/*.log",
    job      = "ir-assist",
    host     = "windows",
  }]
}

loki.source.file "logs" {
  targets    = local.file_match.ir_logs.targets
  forward_to = [loki.write.grafanacloud.receiver]
}

loki.write "grafanacloud" {
  endpoint {
    url = "https://logs-prod-ap-south-1.grafana.net/loki/api/v1/push"

    basic_auth {
      username = "1670096"
      password = env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

otelcol.exporter.otlphttp "grafanacloud" {
  client {
    endpoint = "https://otlp-gateway-prod-ap-south-1.grafana.net/otlp"

    headers = {
      "Authorization" = env("GRAFANA_TEMPO_AUTHORIZATION"),
    }
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.grafanacloud.input]
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}